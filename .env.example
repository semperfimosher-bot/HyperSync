APP_NAME=HyperSync
APP_VERSION=0.1.0
ENVIRONMENT=development

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# Trust forwarded client IPs only from your reverse proxy/load balancer.
# Keep this to explicit proxy IPs/CIDRs; never use "*" on a publicly reachable origin.
UVICORN_FORWARDED_ALLOW_IPS=127.0.0.1
FRONTEND_ORIGINS=http://localhost:4153,http://127.0.0.1:4153,http://localhost:5173,http://127.0.0.1:5173
FRONTEND_PUBLIC_URL=https://hypersynced.app
API_DOCS_ENABLED=false

# Runtime API connection. Use the pooled Neon connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require

# Alembic migrations. Use the direct, non-pooler Neon connection string.
MIGRATION_DATABASE_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?sslmode=require

# Runtime pool limits. Keep total possible connections across all
# service replicas within the database provider's connection budget.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=2
DB_COMMAND_TIMEOUT_SECONDS=30

# Bound requests before authentication or any database access. Keep this below
# DB_POOL_SIZE + DB_MAX_OVERFLOW and leave two connections for background work.
API_MAX_CONCURRENT_REQUESTS=8
API_ADMISSION_TIMEOUT_SECONDS=1
# Uvicorn caps accepted connections above the application admission gate.
UVICORN_LIMIT_CONCURRENCY=32

JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=hypersync-api
JWT_AUDIENCE=hypersync-web
ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=30

# Authentication abuse protection.
AUTH_LOGIN_RATE_LIMIT=10
AUTH_LOGIN_RATE_WINDOW_SECONDS=300
AUTH_LOGIN_IP_RATE_LIMIT=60
AUTH_REGISTER_RATE_LIMIT=20
AUTH_REGISTER_RATE_WINDOW_SECONDS=3600
AUTH_ADMIN_REGISTER_RATE_LIMIT=5
AUTH_ADMIN_REGISTER_RATE_WINDOW_SECONDS=900
AUTH_REFRESH_RATE_LIMIT=120
AUTH_REFRESH_RATE_WINDOW_SECONDS=300

# Password recovery abuse protection.
AUTH_PASSWORD_RECOVERY_RATE_LIMIT=5
AUTH_PASSWORD_RECOVERY_IP_RATE_LIMIT=20
AUTH_PASSWORD_RECOVERY_RATE_WINDOW_SECONDS=900
PASSWORD_RECOVERY_TTL_MINUTES=15
PASSWORD_RECOVERY_MAX_ATTEMPTS=5
# Optional dedicated HMAC secret. When blank, JWT_SECRET is used.
PASSWORD_RECOVERY_SECRET=

# SMTP delivery for password-recovery OTPs and reset links.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=HyperSync
SMTP_STARTTLS=true
SMTP_USE_SSL=false

# Direct-message abuse protection.
MESSAGE_SEND_RATE_LIMIT=60
MESSAGE_SEND_RATE_WINDOW_SECONDS=60

# Web Push / VAPID. Generate one P-256 VAPID key pair for the deployment.
# The public key is safe for browsers; keep the private key server-only.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:admin@example.com
# Only HTTPS endpoints on these provider-controlled host suffixes are accepted.
WEB_PUSH_ALLOWED_HOST_SUFFIXES=fcm.googleapis.com,android.googleapis.com,push.services.mozilla.com,push.apple.com,notify.windows.com

# Server-only destructive admin reset secret. Never expose this as VITE_*.
ADMIN_DATABASE_DELETE_PASSWORD=replace-with-admin-reset-password

# Server-only administrator account creation secret. Never expose this as VITE_*.
ADMIN_ACCOUNT_CREATION_PASSWORD=replace-with-admin-account-creation-password

BOT_JWT_SECRET=replace-with-a-different-long-random-secret
BOT_JWT_AUDIENCE=hypersync-bot
BOT_TOKEN_TTL_MINUTES=60

RCLONE_REMOTE=hypersync-b2

B2_ENDPOINT=https://s3.YOUR-REGION.backblazeb2.com
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
B2_AUDIO_PREFIX=audio
B2_ARTWORK_PREFIX=artwork
B2_PROFILE_PREFIX=profiles
B2_PRESIGNED_URL_TTL_SECONDS=86400
B2_DIRECT_UPLOAD_ENABLED=true
B2_DIRECT_UPLOAD_TTL_SECONDS=300

# Adaptive upload compression. Large/lossless/high-bitrate files are
# converted to validated MP3 VBR only when the result saves enough space.
AUDIO_COMPRESSION_ENABLED=true
AUDIO_COMPRESSION_MP3_VBR_QUALITY=2
AUDIO_COMPRESSION_MIN_SOURCE_KBPS=224
AUDIO_COMPRESSION_MIN_SAVINGS_PERCENT=10
AUDIO_COMPRESSION_TIMEOUT_SECONDS=180

LOCAL_TEMP_ROOT=storage/temporary
LOCAL_UPLOAD_ROOT=storage/uploads
LOCAL_LOG_ROOT=storage/logs

LRCLIB_BASE_URL=https://lrclib.net
LRCLIB_CLIENT_NAME=HyperSync/0.1.0 (https://hypersynced.app)
LRCLIB_NOT_FOUND_RETRY_HOURS=24

# External music metadata. New uploads and on-demand provisioning use
# Deezer + Apple/iTunes as the canonical metadata pair.
DEEZER_API_BASE_URL=https://api.deezer.com
DEEZER_TIMEOUT_SECONDS=3
DEEZER_DETAIL_LIMIT=6

# On-demand catalog provisioning. Metadata lookup and warm-only playback
# sources do not publish. The first successful play starts B2/DB ingest.
ON_DEMAND_SEARCH_LIMIT=100
ON_DEMAND_PREWARM_LIMIT=8
ON_DEMAND_SEARCH_RATE_LIMIT=30
ON_DEMAND_PREPARE_RATE_LIMIT=12
ON_DEMAND_RATE_WINDOW_SECONDS=60
ON_DEMAND_SOURCE_TIMEOUT_SECONDS=12
ON_DEMAND_SESSION_TTL_SECONDS=1800

YT_DLP_SEARCH_RESULTS=8
YT_DLP_SOCKET_TIMEOUT_SECONDS=8
# Optional server-side Netscape-format cookies file. Keep it outside git.
YT_DLP_COOKIES_FILE=

# Legacy metadata providers remain configurable for existing maintenance
# tooling, but are no longer the preferred upload/on-demand provider pair.
# LASTFM_API_KEY is server-only. Never expose it as a VITE_* variable.
LASTFM_BASE_URL=https://ws.audioscrobbler.com
LASTFM_API_KEY=
LASTFM_TIMEOUT_SECONDS=8
LASTFM_MIN_INTERVAL_SECONDS=0.25
LASTFM_CACHE_HOURS=24

# Apple/iTunes Search fallback. No API key is required.
APPLE_SEARCH_BASE_URL=https://itunes.apple.com
APPLE_SEARCH_COUNTRY=US
APPLE_SEARCH_TIMEOUT_SECONDS=8
APPLE_SEARCH_MIN_INTERVAL_SECONDS=3.1
APPLE_SEARCH_CACHE_HOURS=24

# Final public metadata fallback. Keep an identifiable User-Agent.
MUSICBRAINZ_BASE_URL=https://musicbrainz.org
MUSICBRAINZ_USER_AGENT=HyperSynced/0.1.0 (https://hypersynced.app)
MUSICBRAINZ_TIMEOUT_SECONDS=8
MUSICBRAINZ_MIN_INTERVAL_SECONDS=1.1
MUSICBRAINZ_CACHE_HOURS=24

CLIENT_CACHE_HOURS=24
