APP_NAME=HyperSync
ENVIRONMENT=development

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DATABASE?ssl=require

JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
USER_TOKEN_TTL_MINUTES=60

BOT_JWT_SECRET=replace-with-a-different-long-random-secret
BOT_JWT_AUDIENCE=hypersync-bot
BOT_TOKEN_TTL_MINUTES=60

B2_MOUNT_ROOT=R:/HyperSyncB2

LOCAL_TEMP_ROOT=storage/temporary
LOCAL_UPLOAD_ROOT=storage/uploads
LOCAL_LOG_ROOT=storage/logs

AUDIO_DIRECTORY=audio
ARTWORK_DIRECTORY=artwork
THUMBNAIL_DIRECTORY=thumbnails

DEFAULT_MP3_BITRATE=320k
CLIENT_CACHE_HOURS=24