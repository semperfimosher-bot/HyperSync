APP_NAME=HyperSync
APP_VERSION=0.1.0
ENVIRONMENT=development

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
API_DOCS_ENABLED=false

# Runtime API connection. Use the pooled Neon connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require

# Alembic migrations. Use the direct, non-pooler Neon connection string.
MIGRATION_DATABASE_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?sslmode=require

# Runtime pool limits. Keep total possible connections across all
# service replicas within the database provider's connection budget.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=10
DB_COMMAND_TIMEOUT_SECONDS=30

JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=hypersync-api
JWT_AUDIENCE=hypersync-web
ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=30

# Authentication abuse protection.
AUTH_LOGIN_RATE_LIMIT=10
AUTH_LOGIN_RATE_WINDOW_SECONDS=300
AUTH_LOGIN_IP_RATE_LIMIT=60
AUTH_REGISTER_RATE_LIMIT=20
AUTH_REGISTER_RATE_WINDOW_SECONDS=3600
AUTH_ADMIN_REGISTER_RATE_LIMIT=5
AUTH_ADMIN_REGISTER_RATE_WINDOW_SECONDS=900
AUTH_REFRESH_RATE_LIMIT=120
AUTH_REFRESH_RATE_WINDOW_SECONDS=300

# Server-only destructive admin reset secret. Never expose this as VITE_*.
ADMIN_DATABASE_DELETE_PASSWORD=replace-with-admin-reset-password

# Server-only administrator account creation secret. Never expose this as VITE_*.
ADMIN_ACCOUNT_CREATION_PASSWORD=replace-with-admin-account-creation-password

BOT_JWT_SECRET=replace-with-a-different-long-random-secret
BOT_JWT_AUDIENCE=hypersync-bot
BOT_TOKEN_TTL_MINUTES=60

RCLONE_REMOTE=hypersync-b2

B2_ENDPOINT=https://s3.YOUR-REGION.backblazeb2.com
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
B2_AUDIO_PREFIX=audio
B2_ARTWORK_PREFIX=artwork
B2_PROFILE_PREFIX=profiles
B2_PRESIGNED_URL_TTL_SECONDS=86400
B2_DIRECT_UPLOAD_ENABLED=true
B2_DIRECT_UPLOAD_TTL_SECONDS=300

# Adaptive upload compression. Large/lossless/high-bitrate files are
# converted to validated MP3 VBR only when the result saves enough space.
AUDIO_COMPRESSION_ENABLED=true
AUDIO_COMPRESSION_MP3_VBR_QUALITY=2
AUDIO_COMPRESSION_MIN_SOURCE_KBPS=224
AUDIO_COMPRESSION_MIN_SAVINGS_PERCENT=10
AUDIO_COMPRESSION_TIMEOUT_SECONDS=180

LOCAL_TEMP_ROOT=storage/temporary
LOCAL_UPLOAD_ROOT=storage/uploads
LOCAL_LOG_ROOT=storage/logs

LRCLIB_BASE_URL=https://lrclib.net
LRCLIB_CLIENT_NAME=HyperSync/0.1.0 (https://hypersynced.app)
LRCLIB_NOT_FOUND_RETRY_HOURS=24

CLIENT_CACHE_HOURS=24
