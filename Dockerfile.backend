FROM node:22-bookworm-slim AS node_runtime

FROM python:3.13-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

COPY requirements.backend.txt ./

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir -r requirements.backend.txt

COPY --from=node_runtime /usr/local/bin/node /usr/local/bin/node

COPY backend ./backend
COPY bot ./bot
COPY migrations ./migrations
COPY alembic.ini ./

WORKDIR /app/backend

EXPOSE 8000

CMD migration_attempt=1; \
    until python -m alembic -c /app/alembic.ini upgrade head; do \
        if [ "$migration_attempt" -ge "${MIGRATION_MAX_ATTEMPTS:-12}" ]; then \
            echo "Database migrations failed after $migration_attempt attempts." >&2; \
            exit 1; \
        fi; \
        sleep_seconds=$((migration_attempt * 5)); \
        if [ "$sleep_seconds" -gt 30 ]; then sleep_seconds=30; fi; \
        echo "Database migration attempt $migration_attempt failed; retrying in ${sleep_seconds}s..." >&2; \
        sleep "$sleep_seconds"; \
        migration_attempt=$((migration_attempt + 1)); \
    done; \
    exec python -m uvicorn backend.app.main:app --host 0.0.0.0 --port ${PORT:-8000} --proxy-headers --forwarded-allow-ips "${UVICORN_FORWARDED_ALLOW_IPS:-127.0.0.1}" --limit-concurrency ${UVICORN_LIMIT_CONCURRENCY:-100} --backlog ${UVICORN_BACKLOG:-2048} --timeout-keep-alive ${UVICORN_KEEPALIVE_SECONDS:-10}
